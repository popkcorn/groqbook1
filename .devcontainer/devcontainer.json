{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "server.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends fonts-dejavu-core && pip3 install --user -r requirements-bookwright.txt && echo '✅ Bookwright dependencies installed'",
  "postAttachCommand": {
    "server": "uvicorn server:app --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "Bookwright",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}