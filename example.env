# Groq API key. Without it the app runs in demo mode (local fixture prose).
GROQ_API_KEY=gsk_your_key_here

# Model routing — override without touching code. Groq retires IDs regularly:
# https://console.groq.com/docs/deprecations
# BOOKWRIGHT_ARCHITECT_MODEL=openai/gpt-oss-120b
# BOOKWRIGHT_WRITER_MODEL=openai/gpt-oss-20b
# BOOKWRIGHT_EDITOR_MODEL=openai/gpt-oss-20b
# BOOKWRIGHT_CONCURRENCY=2
